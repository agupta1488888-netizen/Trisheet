# Tearsheet environment variables.
#
# Copy the marked sections into the file named beside each heading. Never commit
# a filled-in copy — .env and .env.local are both gitignored.

# =============================================================================
# backend/.env
# =============================================================================

# Deployment environment. One of: development | production
ENVIRONMENT=development

# Log verbosity. One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Port uvicorn binds. Railway overrides this at deploy time.
PORT=8000

# REQUIRED. Contact address sent to SEC in every User-Agent header, as
# "Tearsheet <email>". SEC returns 403 to requests without it, and EDGAR is the
# system's only hard dependency — nothing works until this is set.
EDGAR_CONTACT_EMAIL=you@example.com

# REQUIRED for prose generation. Report generation stops at the writing stage
# without it. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED for persistence. Project URL from Supabase > Project settings > API.
SUPABASE_URL=https://your-project.supabase.co

# REQUIRED for persistence. Service role key — full database access, bypasses
# row level security. Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call this API, comma-separated. Add the Vercel
# production domain and any preview domains that must reach the backend.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# frontend/.env.local
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle. Only put
# values here that are safe to publish.
# =============================================================================

# REQUIRED. Base URL of the FastAPI backend, no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project URL. Same value as SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key. Safe for the browser: row level security
# restricts it to reading published report data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
